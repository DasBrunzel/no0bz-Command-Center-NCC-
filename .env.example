NCC_HOST=127.0.0.1
NCC_PORT=8350
NCC_TOKEN=
NCC_MODE=local
NCC_SERVER_URL=
NCC_UPLOAD_MAX_MB=25
NCC_UPLOAD_TOTAL_MB=512
NCC_RETENTION_HOURS=24
NCC_INTERVAL=1.0
NCC_LHM_URL=http://127.0.0.1:8085/data.json
NCC_DEMO=0
NCC_ALLOW_LOOPBACK_NO_TOKEN=1

# NCC 0.5 server (separate process)
NCC_SERVER_HOST=127.0.0.1
NCC_SERVER_PORT=8350
NCC_SERVER_DATABASE_URL=postgresql+psycopg://ncc:ncc@127.0.0.1:5432/ncc
NCC_SERVER_DATABASE_CHECK_ON_START=1
NCC_SERVER_HEARTBEAT_INTERVAL_SECONDS=10
NCC_SERVER_NODE_OFFLINE_AFTER_SECONDS=30

# NCC 0.5 headless agent (prefer ncc-agent.env on agent hosts)
NCC_AGENT_SERVER_URL=
NCC_AGENT_TOKEN=
NCC_AGENT_DISPLAY_NAME=
NCC_AGENT_COLLECTION_INTERVAL_SECONDS=5
NCC_AGENT_HEARTBEAT_INTERVAL_SECONDS=10
NCC_AGENT_BATCH_SIZE=25
NCC_AGENT_MAX_BUFFER_POINTS=10000
NCC_AGENT_VERIFY_TLS=1
NCC_AGENT_ALLOW_INSECURE_HTTP=0
NCC_AGENT_DEMO=0

