<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen-Widget im NCC-Stil: Signallampe, Flotte online, Warnungen, eigener Akku. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_lamp"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/lamp_off" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.08"
            android:text="NCC · FLOTTE"
            android:textColor="@color/widget_ink3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_semibold"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fleet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/barlow_condensed_bold"
        android:text="–"
        android:textColor="@color/widget_ink"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/widget_alerts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_semibold"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/barlow_regular"
        android:textColor="@color/widget_ink3"
        android:textSize="11sp" />
</LinearLayout>
