[Unit]
Description=no0bz Command Center Agent
Documentation=https://github.com/DasBrunzel/no0bz-Command-Center-NCC-
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ncc/agent.env
ExecStart=/opt/no0bz/ncc/venv/bin/ncc-agent
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/ncc-agent

[Install]
WantedBy=multi-user.target
